{
  "name": "campaigns",
  "version": "2.0.0",
  "description": "Tactical Task Manager Command Center",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "app:build": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "app-builder-bin": "^4.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "lucide-svelte": "^0.475.0",
    "svelte": "^5.20.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.campaigns.app",
    "productName": "Campaigns",
    "copyright": "Copyright © 2026 Campaigns",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/*.sqlite*",
      "!**/*.db*",
      "!make-ico.js",
      "!build-icon.js",
      "!render-icon.js",
      "!Development.md",
      "!Release-*.md",
      "!docs/*",
      "!scratch/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Campaigns",
      "uninstallDisplayName": "Campaigns Uninstaller",
      "displayLanguageSelector": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
